APP_MODE=demo
DATABASE_URL=sqlite:///./nventures.db
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free
TAVILY_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
SPREADSHEET_ID=
SOURCING_TAB_NAME=Active Sourcing
PARTNER_TAB_NAME=Partner List
CONTROL_TAB_NAME=Sourcing Control
# Live sourcing stores locally. Set true only to enable explicit Sheets sync.
SHEETS_SYNC_ENABLED=false
MAX_RESEARCH_PER_RUN=45

# Inbound Google OAuth: run Connect Google.cmd once. Never commit these values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GMAIL_EXPECTED_ACCOUNT=contact@nventures.sg
INBOX_SPREADSHEET_ID=
INBOX_SHEET_TAB=Sheet1
